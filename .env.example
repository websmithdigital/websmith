# ==============================================================================
# WebSmith Digital Platform — Environment Variable Configuration Template
# Copy this file to .env.local or set these variables in your hosting provider
# (e.g. Vercel, Railway, AWS, Coolify, or Docker container).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & PUBLIC URLS
# ------------------------------------------------------------------------------
# Public canonical URL of the deployed application (without trailing slash)
NEXT_PUBLIC_APP_URL=https://websmithdigital.com
NEXT_PUBLIC_API_URL=https://websmithdigital.com

# Server runtime settings
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 2. PRIMARY DATABASE (Neon Serverless PostgreSQL / PgBouncer)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with SSL enabled
# Example: postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/websmith?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Run database schema migrations and collection table bootstrapping on startup
FORCE_DB_INIT=false

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Secret keys for signing JSON Web Tokens (JWT) & API Center access
# Generate random 32+ char hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
API_CENTER_JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Server-only Admin API Key for internal backend execution
ADMIN_API_KEY=replace_with_a_secure_admin_api_key

# ------------------------------------------------------------------------------
# 4. OUTBOUND EMAIL ENGINE (SMTP / PrivateEmail / Resend / Brevo)
# ------------------------------------------------------------------------------
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@websmithdigital.com
SMTP_PASS=replace_with_smtp_password

# Outbound sender identity configuration
MAIL_FROM_ADDRESS=no-reply@websmithdigital.com
MAIL_FROM_NAME=WebSmith Digital
MAIL_SUPPORT_ADDRESS=support@websmithdigital.com
MAIL_SUPPORT_NAME="WebSmith Digital Support Team"
MAIL_SALES_ADDRESS=sales@websmithdigital.com
MAIL_SALES_NAME="WebSmith Digital Sales Team"

# ------------------------------------------------------------------------------
# 5. INBOUND SUPPORT MAILBOX (IMAP Sync)
# ------------------------------------------------------------------------------
MAIL_SUPPORT_IMAP_HOST=mail.privateemail.com
MAIL_SUPPORT_IMAP_PORT=993
MAIL_SUPPORT_IMAP_SECURE=true
MAIL_SUPPORT_IMAP_USERNAME=support@websmithdigital.com
MAIL_SUPPORT_IMAP_PASSWORD=replace_with_imap_password

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED CACHING, RATE LIMITING & QUEUES (Upstash Redis & QStash)
# ------------------------------------------------------------------------------
# Upstash Serverless Redis REST credentials
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_redis_token

# Upstash QStash Cron & Background Queues
QSTASH_URL=https://qstash.upstash.io/v2
QSTASH_TOKEN=replace_with_qstash_token
QSTASH_CURRENT_SIGNING_KEY=replace_with_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=replace_with_qstash_next_signing_key

# ------------------------------------------------------------------------------
# 7. SMS ALERTS & OTP VERIFICATION (Fast2SMS Gateway)
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=replace_with_fast2sms_api_key
FAST2SMS_SENDER_ID=WEBSMS

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH AUTHENTICATION (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# ------------------------------------------------------------------------------
# 9. PUBLIC API & AUDITING CONFIGURATION
# ------------------------------------------------------------------------------
PUBLIC_API_ENABLED=true
PUBLIC_API_AUDIT_ENABLED=true
PUBLIC_API_SIGNATURE_TTL=300
PUBLIC_API_RATE_LIMIT_DEFAULT=60
