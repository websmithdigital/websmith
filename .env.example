# ==============================================================================
# WebSmith Digital Platform — Production Environment Configuration Template
# Copy this file to .env.local for local development, or set these variables
# in your deployment platform (Vercel, AWS, Railway, Docker, or Linux VPS).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# Canonical URLs for client links, OAuth redirects, and webhook callbacks (no trailing slash)
NEXT_PUBLIC_APP_URL="https://websmithdigital.com"
NEXT_PUBLIC_API_URL="https://websmithdigital.com"

# Server runtime mode ('development' or 'production')
NODE_ENV="production"
PORT=3000

# Optional internal backend microservice address (for local proxying)
BACKEND_URL="http://127.0.0.1:5000"

# ------------------------------------------------------------------------------
# 2. NEON SERVERLESS POSTGRESQL (Primary Database)
# ------------------------------------------------------------------------------
# Pooled PostgreSQL connection string via Neon's PgBouncer proxy.
# Format: postgresql://<user>:<password>@<ep-endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://neondb_owner:npg_sampleSecretKey@ep-summer-credit-b3j5staw-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Set to true only on first deploy or when running schema migrations: node scripts/init_db.mjs
FORCE_DB_INIT=false

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# High-entropy 64-character hex strings for signing user session & admin JWTs.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="a4f89d3e8b72c15f90a6e3d2c8b417e9f50821364d97cbef01a23456789abcde"
API_CENTER_JWT_SECRET="e9d8c7b6a5041328f7e6d5c4b3a291807f6e5d4c3b2a1098fedcba9876543210"

# Server-only Admin API Key for internal backend execution (NEVER expose to frontend)
ADMIN_API_KEY="wsd_live_adm_a1b2c3d4e5f67890123456789abcdef0"

# Diagnostic & cleanup secret for authorized operational checks
CLEANUP_SECRET_KEY="wsd_cleanup_sec_9876543210fedcba12345678"

# Super-admin alert notification inbox
ADMIN_ALERT_EMAIL="digitalwebsmith@gmail.com"

# ------------------------------------------------------------------------------
# 4. OUTBOUND EMAIL ENGINE (Namecheap PrivateEmail / SMTP Primary)
